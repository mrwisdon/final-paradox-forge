# Keep repository text deterministic across Windows and Unix clones.
* text=auto eol=lf
*.bat text eol=crlf
*.gradle text eol=lf
*.java text eol=lf
*.json text eol=lf
*.mcfunction text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.toml text eol=lf

# Generated data is always emitted with LF.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf

# Binary assets must never receive line-ending conversion.
*.jar binary
*.nbt binary
*.png binary

# Audio dominates repository size and belongs in Git LFS.
*.ogg filter=lfs diff=lfs merge=lfs -text
